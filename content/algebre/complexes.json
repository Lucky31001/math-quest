{
  "$schema": "../schema.json",
  "id": "complexes",
  "monde": "algebre",
  "ordre": 3,
  "titre": "Nombres complexes",
  "icone": "🌀",
  "resume": "Forme algébrique, module, forme exponentielle, racines $n$-ièmes et trigonométrie.",
  "cours": [
    {
      "titre": "Forme algébrique",
      "blocs": [
        {
          "type": "definition",
          "titre": "Nombre complexe",
          "texte": "Tout $z \\in \\mathbb{C}$ s'écrit de façon unique $z = a + ib$ avec $a = \\mathrm{Re}(z) \\in \\mathbb{R}$, $b = \\mathrm{Im}(z) \\in \\mathbb{R}$ et $i^2 = -1$."
        },
        {
          "type": "definition",
          "titre": "Conjugué et module",
          "texte": "$\\bar z = a - ib$ et $|z| = \\sqrt{a^2 + b^2}$. On a $z\\bar z = |z|^2$, donc pour $z \\neq 0$ : $\\dfrac{1}{z} = \\dfrac{\\bar z}{|z|^2}$."
        },
        {
          "type": "propriete",
          "texte": "$\\overline{z + z'} = \\bar z + \\bar z'$, $\\overline{zz'} = \\bar z\\,\\bar z'$, $|zz'| = |z|\\,|z'|$ et **inégalité triangulaire** : $|z + z'| \\leq |z| + |z'|$ (égalité ssi $z$ et $z'$ sont positivement colinéaires)."
        }
      ]
    },
    {
      "titre": "Forme trigonométrique et exponentielle",
      "blocs": [
        {
          "type": "definition",
          "texte": "Pour $\\theta \\in \\mathbb{R}$ : $e^{i\\theta} = \\cos\\theta + i\\sin\\theta$. Tout $z \\neq 0$ s'écrit $z = r e^{i\\theta}$ avec $r = |z| > 0$ et $\\theta$ **un** argument de $z$ (défini modulo $2\\pi$)."
        },
        {
          "type": "propriete",
          "titre": "Produit",
          "texte": "$e^{i\\theta}e^{i\\theta'} = e^{i(\\theta + \\theta')}$ : dans un produit, les modules se multiplient et les arguments s'ajoutent. $\\overline{e^{i\\theta}} = e^{-i\\theta} = \\dfrac{1}{e^{i\\theta}}$."
        },
        {
          "type": "theoreme",
          "titre": "Formules d'Euler et de Moivre",
          "texte": "$\\cos\\theta = \\dfrac{e^{i\\theta} + e^{-i\\theta}}{2}$, $\\sin\\theta = \\dfrac{e^{i\\theta} - e^{-i\\theta}}{2i}$ et $(\\cos\\theta + i\\sin\\theta)^n = \\cos(n\\theta) + i\\sin(n\\theta)$."
        },
        {
          "type": "methode",
          "titre": "Trouver un argument de $a + ib$",
          "texte": "Calculer $r = |z|$ puis chercher $\\theta$ tel que $\\cos\\theta = \\frac{a}{r}$ et $\\sin\\theta = \\frac{b}{r}$. **Attention** : $\\arctan\\frac{b}{a}$ ne convient que si $a > 0$."
        }
      ]
    },
    {
      "titre": "Racines $n$-ièmes et équations",
      "blocs": [
        {
          "type": "theoreme",
          "titre": "Racines $n$-ièmes de l'unité",
          "texte": "Les solutions de $z^n = 1$ sont les $n$ nombres $\\omega_k = e^{2ik\\pi/n}$, $k \\in \\{0, \\dots, n-1\\}$. Pour $n \\geq 2$ : $\\sum_{k=0}^{n-1} \\omega_k = 0$."
        },
        {
          "type": "theoreme",
          "titre": "Racines $n$-ièmes de $a = \\rho e^{i\\alpha}$",
          "texte": "Les solutions de $z^n = a$ sont les $n$ nombres $\\rho^{1/n} e^{i(\\alpha + 2k\\pi)/n}$, $k \\in \\{0, \\dots, n-1\\}$."
        },
        {
          "type": "methode",
          "titre": "Racines carrées sous forme algébrique",
          "texte": "Pour $z^2 = w$ avec $z = x + iy$ : identifier $x^2 - y^2 = \\mathrm{Re}(w)$, $2xy = \\mathrm{Im}(w)$, et utiliser $x^2 + y^2 = |w|$."
        },
        {
          "type": "theoreme",
          "titre": "Équation du second degré",
          "texte": "$az^2 + bz + c = 0$ ($a \\neq 0$, coefficients complexes) : si $\\delta^2 = \\Delta = b^2 - 4ac$, les solutions sont $\\dfrac{-b \\pm \\delta}{2a}$. Si les coefficients sont réels et $\\Delta < 0$ : $\\delta = i\\sqrt{-\\Delta}$."
        }
      ]
    },
    {
      "titre": "Trigonométrie",
      "blocs": [
        {
          "type": "methode",
          "titre": "Linéariser $\\cos^n$ et $\\sin^n$",
          "texte": "Écrire $\\cos x = \\frac{e^{ix} + e^{-ix}}{2}$, développer avec le binôme, regrouper les termes conjugués. Ex. : $\\cos^2 x = \\frac{1 + \\cos 2x}{2}$, $\\cos^3 x = \\frac{\\cos 3x + 3\\cos x}{4}$."
        },
        {
          "type": "methode",
          "titre": "Angle moitié",
          "texte": "$e^{ia} + e^{ib} = e^{i\\frac{a+b}{2}}\\left(e^{i\\frac{a-b}{2}} + e^{-i\\frac{a-b}{2}}\\right) = 2\\cos\\left(\\frac{a-b}{2}\\right)e^{i\\frac{a+b}{2}}$. En particulier $1 + e^{i\\theta} = 2\\cos\\frac{\\theta}{2}\\,e^{i\\theta/2}$."
        }
      ]
    }
  ],
  "flashcards": [
    {
      "id": "f-module",
      "recto": "Module de $z = a + ib$ ?",
      "verso": "$|z| = \\sqrt{a^2 + b^2}$"
    },
    {
      "id": "f-zzbar",
      "recto": "Que vaut $z\\bar z$ ?",
      "verso": "$z\\bar z = |z|^2$ (un réel positif)."
    },
    {
      "id": "f-inverse",
      "recto": "Forme algébrique de $\\dfrac{1}{z}$ pour $z \\neq 0$ ?",
      "verso": "$\\dfrac{1}{z} = \\dfrac{\\bar z}{|z|^2}$ : on multiplie par le conjugué."
    },
    {
      "id": "f-euler",
      "recto": "Formules d'Euler ?",
      "verso": "$\\cos\\theta = \\dfrac{e^{i\\theta} + e^{-i\\theta}}{2}$ et $\\sin\\theta = \\dfrac{e^{i\\theta} - e^{-i\\theta}}{2i}$"
    },
    {
      "id": "f-moivre",
      "recto": "Formule de Moivre ?",
      "verso": "$(\\cos\\theta + i\\sin\\theta)^n = \\cos(n\\theta) + i\\sin(n\\theta)$, i.e. $(e^{i\\theta})^n = e^{in\\theta}$."
    },
    {
      "id": "f-arg-produit",
      "recto": "Argument d'un produit $zz'$ et d'un quotient $z/z'$ ?",
      "verso": "$\\arg(zz') \\equiv \\arg z + \\arg z'$ et $\\arg(z/z') \\equiv \\arg z - \\arg z' \\pmod{2\\pi}$."
    },
    {
      "id": "f-unite",
      "recto": "Racines $n$-ièmes de l'unité ?",
      "verso": "$e^{2ik\\pi/n}$ pour $k \\in \\{0, \\dots, n-1\\}$ : il y en a exactement $n$."
    },
    {
      "id": "f-somme-unite",
      "recto": "Somme des racines $n$-ièmes de l'unité ($n \\geq 2$) ?",
      "verso": "$0$ (somme géométrique de raison $\\omega = e^{2i\\pi/n} \\neq 1$ : $\\frac{1 - \\omega^n}{1 - \\omega} = 0$)."
    },
    {
      "id": "f-j",
      "recto": "Propriétés de $j = e^{2i\\pi/3}$ ?",
      "verso": "$j^3 = 1$, $1 + j + j^2 = 0$, $\\bar j = j^2$."
    },
    {
      "id": "f-racines-a",
      "recto": "Solutions de $z^n = \\rho e^{i\\alpha}$ ($\\rho > 0$) ?",
      "verso": "$\\rho^{1/n} e^{i\\frac{\\alpha + 2k\\pi}{n}}$, $k \\in \\{0, \\dots, n-1\\}$."
    },
    {
      "id": "f-second-degre",
      "recto": "Solutions de $az^2 + bz + c = 0$ dans $\\mathbb{C}$ ?",
      "verso": "$\\dfrac{-b \\pm \\delta}{2a}$ où $\\delta$ est une racine carrée de $\\Delta = b^2 - 4ac$."
    },
    {
      "id": "f-angle-moitie",
      "recto": "Factoriser $1 + e^{i\\theta}$ ?",
      "verso": "$1 + e^{i\\theta} = 2\\cos\\left(\\frac{\\theta}{2}\\right) e^{i\\theta/2}$ (angle moitié)."
    },
    {
      "id": "f-re-z",
      "recto": "$\\mathrm{Re}(z)$ en fonction de $z$ et $\\bar z$ ?",
      "verso": "$\\mathrm{Re}(z) = \\dfrac{z + \\bar z}{2}$"
    },
    {
      "id": "f-im-z",
      "recto": "$\\mathrm{Im}(z)$ en fonction de $z$ et $\\bar z$ ?",
      "verso": "$\\mathrm{Im}(z) = \\dfrac{z - \\bar z}{2i}$"
    },
    {
      "id": "f-module-exp",
      "recto": "$|e^{i\\theta}|$ pour $\\theta \\in \\mathbb{R}$ ?",
      "verso": "$1$"
    }
  ],
