  "resume": "Notations $\\Sigma$ et $\\Pi$, sommes usuelles, télescopage, coefficients binomiaux et binôme de Newton.",
  "cours": [
    {
      "titre": "Manipuler les sommes",
      "blocs": [
        {
          "type": "propriete",
          "titre": "Linéarité",
          "texte": "$\\sum_{k} (\\lambda a_k + \\mu b_k) = \\lambda \\sum_k a_k + \\mu \\sum_k b_k$. **Attention** : $\\sum a_k b_k \\neq \\left(\\sum a_k\\right)\\left(\\sum b_k\\right)$ en général."
        },
        {
          "type": "methode",
          "titre": "Changement d'indice",
          "texte": "Avec $j = k + 1$ : $\\sum_{k=0}^{n-1} a_{k+1} = \\sum_{j=1}^{n} a_j$. Les **bornes** changent aussi !"
        },
        {
          "type": "theoreme",
          "titre": "Télescopage",
          "texte": "$\\sum_{k=0}^{n} (u_{k+1} - u_k) = u_{n+1} - u_0$."
        },
        {
          "type": "methode",
          "titre": "Sommes doubles",
          "texte": "$\\sum_{1 \\leq i \\leq j \\leq n} a_{ij} = \\sum_{j=1}^{n} \\sum_{i=1}^{j} a_{ij} = \\sum_{i=1}^{n} \\sum_{j=i}^{n} a_{ij}$."
        }
      ]
    },
    {
      "titre": "Sommes usuelles",
      "blocs": [
        {
          "type": "theoreme",
          "texte": "$\\sum_{k=1}^{n} k = \\dfrac{n(n+1)}{2}$, $\\sum_{k=1}^{n} k^2 = \\dfrac{n(n+1)(2n+1)}{6}$, $\\sum_{k=1}^{n} k^3 = \\left(\\dfrac{n(n+1)}{2}\\right)^2$."
        },
        {
          "type": "theoreme",
          "titre": "Somme géométrique",
          "texte": "Pour $q \\neq 1$ : $\\sum_{k=0}^{n} q^k = \\dfrac{1 - q^{n+1}}{1 - q}$. Plus généralement : premier terme $\\times \\dfrac{1 - q^{\\text{nombre de termes}}}{1 - q}$."
        },
        {
          "type": "propriete",
          "titre": "Factorisation",
          "texte": "$a^n - b^n = (a - b)\\sum_{k=0}^{n-1} a^k b^{n-1-k}$."
        }
      ]
    },
    {
      "titre": "Coefficients binomiaux",
      "blocs": [
        {
          "type": "definition",
          "texte": "$n! = \\prod_{k=1}^{n} k$ (et $0! = 1$). Pour $0 \\leq k \\leq n$ : $\\dbinom{n}{k} = \\dfrac{n!}{k!\\,(n-k)!}$, nombre de parties à $k$ éléments d'un ensemble à $n$ éléments."
        },
        {
          "type": "propriete",
          "texte": "Symétrie : $\\binom{n}{k} = \\binom{n}{n-k}$. Formule de Pascal : $\\binom{n}{k} + \\binom{n}{k+1} = \\binom{n+1}{k+1}$."
        },
        {
          "type": "theoreme",
          "titre": "Binôme de Newton",
          "texte": "$(a + b)^n = \\sum_{k=0}^{n} \\binom{n}{k} a^k b^{n-k}$ (dans $\\mathbb{C}$, ou pour des matrices qui commutent). Avec $a = b = 1$ : $\\sum_{k=0}^{n}\\binom{n}{k} = 2^n$."
        }
      ]
    }
  ],
