  "ordre": 6,
  "titre": "Intégration",
  "icone": "📏",
  "resume": "Primitives, intégration par parties, changement de variable, sommes de Riemann.",
  "cours": [
    {
      "titre": "Intégrale et primitives",
      "blocs": [
        { "type": "propriete", "texte": "Linéarité, relation de Chasles $\\int_a^b + \\int_b^c = \\int_a^c$, positivité ($f \\geq 0$ et $a \\leq b$ $\\Rightarrow \\int_a^b f \\geq 0$), et $\\left|\\int_a^b f\\right| \\leq \\int_a^b |f|$." },
        { "type": "theoreme", "titre": "Théorème fondamental", "texte": "Si $f$ est continue sur $I$ et $a \\in I$, $F(x) = \\int_a^x f(t)\\,dt$ est l'unique primitive de $f$ qui s'annule en $a$. Pour toute primitive $G$ : $\\int_a^b f = G(b) - G(a)$." },
        { "type": "propriete", "titre": "Fonction continue positive d'intégrale nulle", "texte": "Si $f$ est continue, positive sur $[a, b]$ ($a < b$) et $\\int_a^b f = 0$, alors $f = 0$ sur $[a, b]$." },
        { "type": "propriete", "titre": "Primitives usuelles", "texte": "$x^n \\to \\frac{x^{n+1}}{n+1}$ ($n \\neq -1$), $\\frac1x \\to \\ln|x|$, $e^{ax} \\to \\frac{e^{ax}}{a}$, $\\cos \\to \\sin$, $\\sin \\to -\\cos$, $\\frac{1}{1 + x^2} \\to \\arctan$, $\\frac{u'}{u} \\to \\ln|u|$, $u'e^u \\to e^u$." }
      ]
    },
    {
      "titre": "Techniques de calcul",
      "blocs": [
        { "type": "theoreme", "titre": "Intégration par parties", "texte": "Pour $u, v$ de classe $C^1$ : $\\int_a^b u v' = [uv]_a^b - \\int_a^b u'v$. On dérive le facteur qui se simplifie (polynôme, $\\ln$) et on intègre l'autre." },
        { "type": "theoreme", "titre": "Changement de variable", "texte": "Pour $\\varphi$ de classe $C^1$ : $\\int_a^b f(\\varphi(t))\\varphi'(t)\\,dt = \\int_{\\varphi(a)}^{\\varphi(b)} f(x)\\,dx$. **Ne pas oublier de changer les bornes** et $dx = \\varphi'(t)\\,dt$." },
        { "type": "methode", "titre": "Fractions rationnelles simples", "texte": "Décomposer : $\\frac{1}{x^2 - 1} = \\frac12\\left(\\frac{1}{x - 1} - \\frac{1}{x + 1}\\right)$, puis intégrer chaque terme en $\\ln$." },
        { "type": "theoreme", "titre": "Sommes de Riemann", "texte": "Si $f$ est continue sur $[0, 1]$ : $\\dfrac1n\\sum_{k=1}^{n} f\\left(\\dfrac kn\\right) \\xrightarrow[n \\to \\infty]{} \\int_0^1 f(x)\\,dx$." }
      ]
    }
  ],
  "flashcards": [
