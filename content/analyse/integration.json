    { "id": "f-cdv", "recto": "Formule du changement de variable ?", "verso": "$\\int_a^b f(\\varphi(t))\\varphi'(t)\\,dt = \\int_{\\varphi(a)}^{\\varphi(b)} f(x)\\,dx$" },
    { "id": "f-tfa", "recto": "Dérivée de $x \\mapsto \\int_a^x f(t)\\,dt$ ($f$ continue) ?", "verso": "$f(x)$" },
    { "id": "f-prim-inv", "recto": "Primitive de $\\frac{1}{x}$ ?", "verso": "$\\ln|x|$ (sur un intervalle ne contenant pas 0)." },
    { "id": "f-prim-u-u", "recto": "Primitive de $\\dfrac{u'}{u}$ ?", "verso": "$\\ln|u|$" },
    { "id": "f-prim-arctan", "recto": "Primitive de $\\dfrac{1}{1 + x^2}$ ?", "verso": "$\\arctan x$" },
    { "id": "f-prim-exp", "recto": "Primitive de $e^{ax}$ ($a \\neq 0$) ?", "verso": "$\\dfrac{1}{a}e^{ax}$" },
    { "id": "f-prim-ln", "recto": "Primitive de $\\ln x$ ?", "verso": "$x\\ln x - x$ (par IPP)." },
    { "id": "f-riemann", "recto": "Limite de $\\frac1n\\sum_{k=1}^{n} f\\left(\\frac kn\\right)$ ?", "verso": "$\\int_0^1 f(x)\\,dx$ ($f$ continue)." },
    { "id": "f-chasles", "recto": "Relation de Chasles ?", "verso": "$\\int_a^b f + \\int_b^c f = \\int_a^c f$" },
    { "id": "f-inegalite", "recto": "Inégalité triangulaire pour les intégrales ?", "verso": "$\\left|\\int_a^b f\\right| \\leq \\int_a^b |f|$ pour $a \\leq b$." },
    { "id": "f-positive-nulle", "recto": "$f$ continue, $\\geq 0$ et $\\int_a^b f = 0$ ($a < b$) : conclusion ?", "verso": "$f = 0$ sur $[a, b]$." }
