{
  "$schema": "../schema.json",
  "id": "suites",
  "monde": "analyse",
  "ordre": 2,
  "titre": "Suites réelles",
  "icone": "🔁",
  "resume": "Limites, suites monotones, adjacentes, extraites et récurrentes.",
  "cours": [
    {
      "titre": "Limites",
      "blocs": [
        {
          "type": "definition",
          "texte": "$u_n \\to \\ell$ si $\\forall \\varepsilon > 0,\\ \\exists N,\\ \\forall n \\geq N,\\ |u_n - \\ell| \\leq \\varepsilon$. La limite, si elle existe, est unique. Une suite convergente est bornée."
        },
        {
          "type": "theoreme",
          "titre": "Gendarmes",
          "texte": "Si $v_n \\leq u_n \\leq w_n$ à partir d'un certain rang et $v_n, w_n \\to \\ell$, alors $u_n \\to \\ell$."
        },
        {
          "type": "remarque",
          "titre": "Formes indéterminées",
          "texte": "$\\infty - \\infty$, $0 \\times \\infty$, $\\frac{\\infty}{\\infty}$, $\\frac00$, $1^\\infty$, $0^0$, $\\infty^0$. Pour $1^\\infty$ : écrire $u_n^{v_n} = e^{v_n\\ln u_n}$."
        }
      ]
    },
    {
      "titre": "Théorèmes d'existence",
      "blocs": [
        {
          "type": "theoreme",
          "titre": "Limite monotone",
          "texte": "Une suite croissante et majorée converge ; une suite croissante non majorée tend vers $+\\infty$."
        },
        {
          "type": "theoreme",
          "titre": "Suites adjacentes",
          "texte": "Si $(u_n)$ croît, $(v_n)$ décroît et $v_n - u_n \\to 0$, alors elles convergent vers la même limite $\\ell$, avec $u_n \\leq \\ell \\leq v_n$."
        },
        {
          "type": "theoreme",
          "titre": "Suites extraites",
          "texte": "Si $u_n \\to \\ell$, toute suite extraite tend vers $\\ell$. Si $u_{2n} \\to \\ell$ et $u_{2n+1} \\to \\ell$, alors $u_n \\to \\ell$. **Bolzano-Weierstrass** : toute suite bornée admet une suite extraite convergente."
        }
      ]
    },
    {
      "titre": "Suites récurrentes",
      "blocs": [
        {
          "type": "methode",
          "titre": "$u_{n+1} = f(u_n)$",
          "texte": "Si $u_n \\to \\ell$ et $f$ est continue en $\\ell$, alors $f(\\ell) = \\ell$ (point fixe). On étudie la monotonie de $(u_n)$ (signe de $f(x) - x$, ou $f$ croissante) et on borne la suite."
        },
        {
          "type": "methode",
          "titre": "Arithmético-géométrique",
          "texte": "$u_{n+1} = qu_n + r$ ($q \\neq 1$) : avec $\\ell = \\frac{r}{1 - q}$, $(u_n - \\ell)$ est géométrique de raison $q$, d'où $u_n = \\ell + q^n(u_0 - \\ell)$."
        },
        {
          "type": "methode",
          "titre": "Récurrence linéaire d'ordre 2",
          "texte": "$u_{n+2} = au_{n+1} + bu_n$ : racines de $r^2 = ar + b$. Deux racines distinctes $r_1, r_2$ : $u_n = \\lambda r_1^n + \\mu r_2^n$ ; racine double $r$ : $u_n = (\\lambda + \\mu n)r^n$."
        }
      ]
    }
  ],
  "flashcards": [
    {
      "id": "f-def-limite",
      "recto": "Définition de $u_n \\to \\ell$ ?",
      "verso": "$\\forall \\varepsilon > 0,\\ \\exists N,\\ \\forall n \\geq N,\\ |u_n - \\ell| \\leq \\varepsilon$"
    },
    {
      "id": "f-monotone",
      "recto": "Théorème de la limite monotone ?",
      "verso": "Croissante majorée $\\Rightarrow$ converge ; croissante non majorée $\\Rightarrow$ tend vers $+\\infty$."
    },
    {
      "id": "f-adjacentes",
