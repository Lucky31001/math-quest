  "resume": "Exponentielle, logarithme, puissances, trigonométrie et réciproques, fonctions hyperboliques.",
  "cours": [
    {
      "titre": "Exponentielle, logarithme, puissances",
      "blocs": [
        {
          "type": "propriete",
          "texte": "$\\ln$ est définie sur $]0, +\\infty[$, $\\ln(ab) = \\ln a + \\ln b$, $\\ln(a^n) = n\\ln a$, $(\\ln x)' = \\frac{1}{x}$. $\\exp$ est sa réciproque : $e^{a+b} = e^ae^b$, $(e^x)' = e^x$."
        },
        {
          "type": "definition",
          "titre": "Puissances réelles",
          "texte": "Pour $x > 0$ et $a \\in \\mathbb{R}$ : $x^a = e^{a\\ln x}$, et $(x^a)' = a x^{a-1}$."
        },
        {
          "type": "theoreme",
          "titre": "Croissances comparées",
          "texte": "Pour $a, b > 0$ : $\\dfrac{(\\ln x)^a}{x^b} \\xrightarrow[x \\to +\\infty]{} 0$, $\\dfrac{x^a}{e^{bx}} \\xrightarrow[x \\to +\\infty]{} 0$, $x^a|\\ln x|^b \\xrightarrow[x \\to 0^+]{} 0$."
        }
      ]
    },
    {
      "titre": "Trigonométrie et réciproques",
      "blocs": [
        {
          "type": "propriete",
          "texte": "$\\cos^2 + \\sin^2 = 1$, $\\tan = \\frac{\\sin}{\\cos}$, $\\tan' = 1 + \\tan^2 = \\frac{1}{\\cos^2}$. $\\cos(a+b) = \\cos a\\cos b - \\sin a\\sin b$, $\\sin(a+b) = \\sin a\\cos b + \\cos a\\sin b$."
        },
        {
          "type": "definition",
          "titre": "Fonctions réciproques",
          "texte": "$\\arcsin : [-1, 1] \\to \\left[-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right]$, $\\arccos : [-1, 1] \\to [0, \\pi]$, $\\arctan : \\mathbb{R} \\to \\left]-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right[$."
        },
        {
          "type": "theoreme",
          "titre": "Dérivées",
          "texte": "$\\arcsin'(x) = \\dfrac{1}{\\sqrt{1 - x^2}}$, $\\arccos'(x) = -\\dfrac{1}{\\sqrt{1 - x^2}}$ sur $]-1, 1[$, $\\arctan'(x) = \\dfrac{1}{1 + x^2}$."
        },
        {
          "type": "remarque",
          "titre": "Piège classique",
          "texte": "$\\arcsin(\\sin x) = x$ **seulement** si $x \\in \\left[-\\frac{\\pi}{2}, \\frac{\\pi}{2}\\right]$. Par exemple $\\arcsin(\\sin \\pi) = 0$."
        },
        {
          "type": "propriete",
          "texte": "$\\arccos x + \\arcsin x = \\frac{\\pi}{2}$ sur $[-1, 1]$ ; $\\arctan x + \\arctan\\frac{1}{x} = \\frac{\\pi}{2}$ pour $x > 0$ (et $-\\frac{\\pi}{2}$ pour $x < 0$)."
        }
      ]
    },
    {
      "titre": "Fonctions hyperboliques",
      "blocs": [
        {
          "type": "definition",
          "texte": "$\\operatorname{ch} x = \\dfrac{e^x + e^{-x}}{2}$, $\\operatorname{sh} x = \\dfrac{e^x - e^{-x}}{2}$, $\\operatorname{th} = \\dfrac{\\operatorname{sh}}{\\operatorname{ch}}$."
        },
        {
          "type": "propriete",
          "texte": "$\\operatorname{ch}^2 x - \\operatorname{sh}^2 x = 1$, $\\operatorname{ch}' = \\operatorname{sh}$, $\\operatorname{sh}' = \\operatorname{ch}$ (pas de signe moins !). $\\operatorname{ch}$ est paire, $\\operatorname{sh}$ est impaire."
        }
      ]
    }
  ],
